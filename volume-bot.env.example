# ================ API 配置 (必需) ================
# 从 Backpack Exchange 获取的 API 密钥
BACKPACK_API_KEY=your_base64_encoded_public_key_here
BACKPACK_PRIVATE_KEY=your_base64_encoded_private_key_here

# ================ 速刷交易配置 ================
# 交易对 (默认: BTC_USDC_PERP)
VOLUME_SYMBOL=BTC_USDC_PERP

# 每个订单金额 USDC (默认: 100)
VOLUME_ORDER_AMOUNT=100

# 限价挂单方向: buy 或 sell (默认: buy)
VOLUME_LIMIT_SIDE=buy

# 完整交易次数上限 (默认: 1000)
VOLUME_MAX_TRADES=1000

# ================ 波动风控配置 ================
# 波动风控1：1分钟价格变化阈值 (默认: 0.02 = 2%)
# 当过去1分钟价格变化超过此百分比时，暂停程序5分钟
VOLUME_VOLATILITY_1_THRESHOLD=0.02

# 波动风控2：5分钟价格变化阈值 (默认: 0.05 = 5%)
# 当过去5分钟价格变化超过此百分比时，暂停程序15分钟
VOLUME_VOLATILITY_2_THRESHOLD=0.05

# ================ 手续费配置 ================
# 挂单手续费率 (默认: 0.0001 = 0.01%)
MAKER_FEE=0.0001

# 市价单手续费率 (默认: 0.00026 = 0.026%)
TAKER_FEE=0.00026

# ================ 日志配置 ================
# 日志级别: DEBUG, INFO, WARN, ERROR (默认: INFO)
LOG_LEVEL=INFO

# 启用CSV交易日志 (默认: true)
ENABLE_CSV_LOG=true

# 启用文件调试日志 (默认: true)
ENABLE_FILE_LOG=true

# ================ 测试模式配置 ================
# 测试模式: true/false (默认: false)
# 测试模式下遇到错误立即停止，便于调试
VOLUME_TEST_MODE=false

# ================ 示例配置说明 ================
# 
# 速刷交易模式工作流程：
# 1. 下限价开仓订单（buy/sell）
# 2. 订单成交后立即下市价关仓订单
# 3. 重复上述过程直到达到交易次数上限
#
# 波动风控机制：
# - 1分钟内价格变化超过2%：暂停5分钟
# - 5分钟内价格变化超过5%：暂停15分钟
# - 暂停期间会取消当前限价订单
# - 波动降低后自动恢复交易
#
# 注意事项：
# - 确保账户有足够的USDC余额
# - 建议先用小金额测试
# - 监控网络连接稳定性
# - 关注市场波动情况
