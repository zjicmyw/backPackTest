# Backpack 交易机器人环境变量配置示例
# 复制此文件为 .env 并填入您的实际配置
# 支持所有机器人模式：剥头皮、速刷交易、限价刷量

# ================ API 配置 (必需) ================
# 从 Backpack Exchange 获取您的 API 密钥
BACKPACK_API_KEY=your_base64_encoded_public_key_here
BACKPACK_PRIVATE_KEY=your_base64_encoded_private_key_here

# ================ 通用交易配置 ================
# 交易对 (默认: BTC_USDC_PERP)
SYMBOL=BTC_USDC_PERP

# 每个订单金额 USDC (默认: 100)
ORDER_AMOUNT=100

# 手续费配置
# 挂单手续费 (默认: 0.0001 = 0.01%)
MAKER_FEE=0.0001
# 吃单手续费 (默认: 0.00026 = 0.026%)
TAKER_FEE=0.00026

# ================ 剥头皮机器人配置 ================
# 除手续费外的净盈利比例 (默认: 0.0001 = 0.01%)
# 例如：MAKER_FEE=0.0001，买卖手续费=0.02%，净盈利0.01%，总涨幅需要0.03%
PROFIT_TARGET=0.0001

# 订单间等待时间 秒 (默认: 450)
ORDER_WAIT_TIME=450

# 单币种持仓最大金额，单位USDC (默认: 40000)
# 当持仓价值达到此限制时，不再下更多该币种订单
MAX_POSITION_VALUE=40000

# 交易方向: buy 或 sell (默认: buy)
TRADE_DIRECTION=buy

# 仅挂单模式 - 只做 maker，不做 taker (默认: true)
# 影响所有订单：开仓订单和止盈订单都将使用仅挂单模式
# 设置为 false 则允许吃单（成为 taker）
POST_ONLY=true

# 最小价格差异要求 (默认: 0.00015 = 0.015%)
# 买单：新价格需要比持仓入场价格至少低此百分比
# 卖单：新价格需要比持仓入场价格至少高此百分比
# 确保有足够价差来盈利
MIN_PRICE_DIFFERENCE=0.00015

# 价格区间限制（可选）
# 当价格超出此区间时，停止增加仓位，但允许关闭或减少仓位
# 最小可挂单价格（留空则不限制）
MIN_ORDER_PRICE=
# 最大可挂单价格（留空则不限制）
MAX_ORDER_PRICE=

# ================ 时间段配置 (UTC+8) ================
# 特殊时间段开始时间 (24小时制，格式: HH:MM，默认: 09:00)
# 在此时间段内，订单金额和价格差异会有特殊调整
TIME_SLOT_START=09:00

# 特殊时间段结束时间 (24小时制，格式: HH:MM，默认: 17:00)
# 在此时间段内，订单金额和价格差异会有特殊调整
TIME_SLOT_END=17:00

# 是否启用时间段配置 (默认: true)
ENABLE_TIME_SLOT=true

# ================ 持续时间倍数配置 ================
# 根据上次持仓持续时间调整订单金额倍数（有效期5分钟）
# 0-1分钟持续时间的订单金额倍数 (默认: 3)
DURATION_MULTIPLIER_0_TO_1=3

# 1-3分钟持续时间的订单金额倍数 (默认: 2)
DURATION_MULTIPLIER_1_TO_3=2

# 3-5分钟持续时间的订单金额倍数 (默认: 1.5)
DURATION_MULTIPLIER_3_TO_5=1.5

# ================ 速刷交易配置 ================
# 速刷交易对 (默认: BTC_USDC_PERP)
VOLUME_SYMBOL=BTC_USDC_PERP

# 速刷每个订单金额 USDC (默认: 100)
VOLUME_ORDER_AMOUNT=100

# 限价挂单方向: buy 或 sell (默认: buy)
VOLUME_LIMIT_SIDE=buy

# 完整交易次数上限 (默认: 1000)
VOLUME_MAX_TRADES=1000

# ================ 波动风控配置 ================
# 波动风控1：1分钟价格变化阈值 (默认: 0.02 = 2%)
# 当过去1分钟价格变化超过此百分比时，暂停程序5分钟
VOLUME_VOLATILITY_1_THRESHOLD=0.02

# 波动风控2：5分钟价格变化阈值 (默认: 0.05 = 5%)
# 当过去5分钟价格变化超过此百分比时，暂停程序15分钟
VOLUME_VOLATILITY_2_THRESHOLD=0.05

# ================ 交易模式配置 ================
# 限价平仓模式配置
VOLUME_PRICE_CHECK_INTERVAL=1000
VOLUME_ORDER_TIMEOUT=30

# ================ 限价刷量模式配置 ================
# 是否启用限价刷量模式: true/false (默认: false)
# 限价刷量模式：纯限价交易，禁止市价单
# - 无持仓时：同时维护买1和卖1限价订单
# - 有持仓时：维护平仓限价订单
# - 实时调整订单价格到1档位
VOLUME_LIMIT_MODE=false

# 价格检查间隔（毫秒）- 建议5秒，避免过于频繁的订单操作
VOLUME_PRICE_CHECK_INTERVAL=5000

# 订单超时时间（秒）
VOLUME_ORDER_TIMEOUT=30

# 最大价格调整次数
VOLUME_MAX_ADJUSTMENTS=100

# 订单数量
VOLUME_ORDER_QUANTITY=0.001

# 最大持仓金额限制（USDC）
VOLUME_MAX_POSITION_VALUE=1000

# ================ 测试模式配置 ================
# 测试模式: true/false (默认: false)
# 测试模式下遇到错误立即停止，便于调试
VOLUME_TEST_MODE=false

# ================ 日志配置 ================
# 日志级别: DEBUG, INFO, WARN, ERROR (默认: INFO)
LOG_LEVEL=INFO

# 启用CSV交易日志 (默认: true)
ENABLE_CSV_LOG=true

# 启用文件日志 (默认: true)
ENABLE_FILE_LOG=true

# ================ 多账户配置 ================
# 账户1配置
ACCOUNT_1_API_KEY=your_api_key_1_here
ACCOUNT_1_PRIVATE_KEY=your_private_key_1_here
ACCOUNT_1_NAME=主账户

# 账户2配置
ACCOUNT_2_API_KEY=your_api_key_2_here
ACCOUNT_2_PRIVATE_KEY=your_private_key_2_here
ACCOUNT_2_NAME=交易账户

# ================ 机器人模式说明 ================
# 
# 1. 剥头皮机器人 (scalping-bot.js):
#    - 基于价格差异的快速交易
#    - 支持时间段和持续时间倍数配置
#    - 适合高频交易策略
#
# 2. 速刷交易机器人 (volume-bot.js):
#    - 快速完成大量交易
#    - 限价开仓+市价平仓模式
#    - 适合刷交易量
#    - 支持限价刷量模式切换
#
# 3. 限价刷量机器人 (limit-volume-bot.js):
#    - 纯限价交易，禁止市价单
#    - 实时调整订单价格到1档位
#    - 严格持仓方向限制
#    - 适合稳定的限价交易
#
# 工作流程说明：
# 
# 剥头皮模式：
# 1. 下限价开仓订单
# 2. 等待价格达到盈利目标
# 3. 下限价平仓订单
# 4. 重复上述过程
#
# 速刷交易模式：
# 1. 下限价开仓订单（buy/sell）
# 2. 订单成交后立即下市价关仓订单
# 3. 重复上述过程直到达到交易次数上限
#
# 限价刷量模式：
# 1. 无持仓时：同时维护买1和卖1限价订单
# 2. 任一订单成交后：取消另一个订单，创建平仓订单
# 3. 平仓订单成交后：重新创建买1和卖1订单
# 4. 实时调整所有订单价格到1档位
# 5. 持仓金额限制：超过最大持仓金额时，禁止同方向开仓
#
# 波动风控机制：
# - 1分钟内价格变化超过2%：暂停5分钟
# - 5分钟内价格变化超过5%：暂停15分钟
# - 暂停期间会取消当前限价订单
# - 波动降低后自动恢复交易
#
# 注意事项：
# - 确保账户有足够的USDC余额
# - 建议先用小金额测试
# - 监控网络连接稳定性
# - 关注市场波动情况
# - 限价刷量模式需要更频繁的API调用
# - 不同机器人模式使用不同的配置参数