# Backpack 剥头皮交易机器人环境变量配置示例
# 复制此文件为 .env 并填入您的实际配置

# ================ API 配置 (必需) ================
# 从 Backpack Exchange 获取您的 API 密钥
BACKPACK_API_KEY=your_base64_encoded_public_key_here
BACKPACK_PRIVATE_KEY=your_base64_encoded_private_key_here

# ================ 交易配置 ================
# 交易对 (默认: BTC_USDC_PERP)
SYMBOL=BTC_USDC_PERP

# 每个订单金额 USDC (默认: 100)
ORDER_AMOUNT=500

# 除手续费外的净盈利比例 (默认: 0.0001 = 0.01%)
# 例如：MAKER_FEE=0.0001，买卖手续费=0.02%，净盈利0.01%，总涨幅需要0.03%
PROFIT_TARGET=0.0001

# 订单间等待时间 秒 (默认: 450)
ORDER_WAIT_TIME=450

# 单币种持仓最大金额，单位USDC (默认: 40000)
# 当持仓价值达到此限制时，不再下更多该币种订单
MAX_POSITION_VALUE=40000

# 交易方向: buy 或 sell (默认: buy)
TRADE_DIRECTION=buy

# 手续费配置
# 挂单手续费 (默认: 0.0001 = 0.01%)
MAKER_FEE=0.0001
# 吃单手续费 (默认: 0.00026 = 0.026%)
TAKER_FEE=0.00026

# 仅挂单模式 - 只做 maker，不做 taker (默认: true)
# 影响所有订单：开仓订单和止盈订单都将使用仅挂单模式
# 设置为 false 则允许吃单（成为 taker）
POST_ONLY=true

# 最小价格差异要求 (默认: 0.00015 = 0.015%)
# 买单：新价格需要比持仓入场价格至少低此百分比
# 卖单：新价格需要比持仓入场价格至少高此百分比
# 确保有足够价差来盈利
MIN_PRICE_DIFFERENCE=0.00015

# ================ 时间段配置 (UTC+8) ================
# 特殊时间段开始时间 (24小时制，格式: HH:MM，默认: 09:00)
# 在此时间段内，订单金额和价格差异会有特殊调整
TIME_SLOT_START=09:00

# 特殊时间段结束时间 (24小时制，格式: HH:MM，默认: 17:00)
# 在此时间段内，订单金额和价格差异会有特殊调整
TIME_SLOT_END=17:00

# 是否启用时间段配置 (默认: true)
ENABLE_TIME_SLOT=true

# ================ 日志配置 ================
# 日志级别: DEBUG, INFO, WARN, ERROR (默认: INFO)
LOG_LEVEL=INFO

# 启用CSV交易日志 (默认: true)
ENABLE_CSV_LOG=true

# 启用文件日志 (默认: true)
ENABLE_FILE_LOG=true


# ================ 账户1配置 ================
ACCOUNT_1_API_KEY=your_api_key_1_here
ACCOUNT_1_PRIVATE_KEY=your_private_key_1_here
ACCOUNT_1_NAME=主账户

# ================ 账户2配置 ================
ACCOUNT_2_API_KEY=your_api_key_2_here
ACCOUNT_2_PRIVATE_KEY=your_private_key_2_here
ACCOUNT_2_NAME=交易账户


