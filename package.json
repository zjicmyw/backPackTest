{
  "name": "backpack-api-demo",
  "version": "1.0.0",
  "description": "Backpack Exchange API 自动化交易脚本演示",
  "main": "start-bot.js",
  "scripts": {
    "start": "node start-bot.js",
    "bot": "node start-bot.js",
    "bot:help": "node start-bot.js --help",
    "volume-bot": "node start-volume-bot.js",
    "volume-bot:help": "node start-volume-bot.js --help",
    "rebalancer": "node start-rebalancer.js",
    "rebalancer:start": "pm2 start ecosystem.config.js --only backpack-balance",
    "rebalancer:stop": "pm2 stop backpack-balance",
    "rebalancer:restart": "pm2 restart backpack-balance",
    "rebalancer:logs": "pm2 logs backpack-balance",
    "rebalancer:status": "pm2 status backpack-balance"
  },
  "keywords": [
    "backpack",
    "crypto",
    "trading",
    "api",
    "automation"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.2",
    "ed25519": "^0.0.5",
    "node-fetch": "^2.6.7",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/backpack-api-demo"
  }
}
